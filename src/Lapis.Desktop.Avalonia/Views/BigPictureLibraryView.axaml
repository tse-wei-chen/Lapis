<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="Lapis.Desktop.Avalonia.Views.BigPictureLibraryView"
             Background="#0A111C" Foreground="#F0F5FA"
             Focusable="True">
  <UserControl.Styles>
    <Style Selector="Button.bp-nav">
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="Foreground" Value="#A9B8C9"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="CornerRadius" Value="8"/>
      <Setter Property="Padding" Value="20,12"/>
      <Setter Property="FontSize" Value="17"/>
      <Setter Property="Transitions">
        <Transitions>
          <BrushTransition Property="Background" Duration="0:0:0.16"/>
          <BrushTransition Property="Foreground" Duration="0:0:0.16"/>
        </Transitions>
      </Setter>
    </Style>
    <Style Selector="Button.bp-nav:pointerover, Button.bp-nav:focus-visible">
      <Setter Property="Foreground" Value="#F2FAFF"/>
      <Setter Property="Background" Value="#263D50"/>
    </Style>
    <Style Selector="Button.bp-nav.selected">
      <Setter Property="Foreground" Value="#FFFFFF"/>
      <Setter Property="Background" Value="#304E65"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
    </Style>
    <Style Selector="Button.bp-tile">
      <Setter Property="Background" Value="#182638"/>
      <Setter Property="BorderBrush" Value="#354A60"/>
      <Setter Property="BorderThickness" Value="2"/>
      <Setter Property="CornerRadius" Value="10"/>
      <Setter Property="Padding" Value="0"/>
      <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
      <Setter Property="VerticalContentAlignment" Value="Stretch"/>
      <Setter Property="Transitions">
        <Transitions>
          <BrushTransition Property="Background" Duration="0:0:0.18"/>
          <BrushTransition Property="BorderBrush" Duration="0:0:0.18"/>
        </Transitions>
      </Setter>
    </Style>
    <Style Selector="Button.bp-tile:pointerover, Button.bp-tile:focus-visible">
      <Setter Property="Background" Value="#284457"/>
      <Setter Property="BorderBrush" Value="#9DDFEE"/>
      <Setter Property="BorderThickness" Value="3"/>
    </Style>
    <Style Selector="Button.bp-primary">
      <Setter Property="Background" Value="#B7E7FA"/>
      <Setter Property="Foreground" Value="#071724"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="CornerRadius" Value="8"/>
      <Setter Property="Padding" Value="25,13"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="FontSize" Value="16"/>
    </Style>
    <Style Selector="Button.bp-primary:pointerover">
      <Setter Property="Background" Value="#E3F7FF"/>
    </Style>
    <Style Selector="Button.bp-secondary">
      <Setter Property="Background" Value="#6B253A4B"/>
      <Setter Property="Foreground" Value="#E8F2FA"/>
      <Setter Property="BorderBrush" Value="#526579"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="CornerRadius" Value="8"/>
      <Setter Property="Padding" Value="18,12"/>
    </Style>
    <Style Selector="Button.bp-secondary:pointerover">
      <Setter Property="Background" Value="#456075"/>
    </Style>
  </UserControl.Styles>
  <Grid x:Name="BigPictureRoot" AutomationProperties.AutomationId="Lapis.Library.Root" RowDefinitions="*,46"
        Background="#0A111C">

    <ScrollViewer Grid.Row="0" x:Name="BigPictureScroll"
                  HorizontalScrollBarVisibility="Disabled"
                  VerticalScrollBarVisibility="Auto">
      <StackPanel Spacing="25" Margin="42,28,42,42">

        <!-- Hero backdrop is sourced only from user-imported media artwork.
             It is not a fictitious poster or an external metadata scrape. -->
        <Border x:Name="BigPictureHero" AutomationProperties.AutomationId="Lapis.Library.Hero" Height="310" ClipToBounds="True"
                CornerRadius="16" Background="#142336"
                BorderBrush="#33495F" BorderThickness="1"
                IsVisible="{Binding HasFeaturedCard}">
          <Grid>
            <Image Source="{Binding FeaturedCard.Poster}" Stretch="UniformToFill"
                   Opacity="0.3"/>
            <Border Background="#9A0B1726"/>
            <Grid ColumnDefinitions="*,392" Margin="38,26,28,26"
                  ColumnSpacing="24">
              <StackPanel VerticalAlignment="Center" Spacing="10">
                <TextBlock Text="NOW IN YOUR CINEMA" FontSize="12"
                           LetterSpacing="2" FontWeight="Bold"
                           Foreground="#9EDBE9"/>
                <TextBlock Text="{Binding FeaturedCard.Title}" FontSize="38"
                           FontWeight="SemiBold" Foreground="#FFFFFF"
                           TextTrimming="CharacterEllipsis" MaxLines="2"
                           TextWrapping="Wrap"/>
                <TextBlock Text="{Binding FeaturedCard.AvailabilityLabel}"
                           FontSize="13" Foreground="#B6C6D5"/>
                <StackPanel Orientation="Horizontal" Spacing="12" Margin="0,15,0,0">
                  <Button Classes="bp-primary" Content="{Binding FeaturedCard.PlayActionLabel}"
                          AutomationProperties.AutomationId="Lapis.Library.PlayFeatured"
                          Click="FeaturedPlay_Click" AutomationProperties.Name="播放選中影片"/>
                  <Button Classes="bp-secondary" Content="更多資訊"
                          Click="FeaturedDetails_Click"
                          AutomationProperties.AutomationId="Lapis.Library.FeaturedDetails"
                          AutomationProperties.Name="檢視精選電影詳細資訊"/>
                </StackPanel>
              </StackPanel>
              <Border Grid.Column="1" Width="392" Height="222"
                      Background="#243448" CornerRadius="10"
                      ClipToBounds="True" VerticalAlignment="Center"
                      BorderBrush="#5E7488" BorderThickness="1">
                <Grid>
                  <Image Source="{Binding FeaturedCard.Poster}"
                         Stretch="Uniform"/>
                  <TextBlock Text="{Binding FeaturedCard.PlaceholderGlyph}" FontSize="92" FontWeight="Light"
                             HorizontalAlignment="Center" VerticalAlignment="Center"
                             Foreground="#506A81"
                             IsVisible="{Binding FeaturedCard.ShowPlaceholder}"/>
                  <TextBlock Text="{Binding FeaturedCard.PlaceholderCaption}"
                             IsVisible="{Binding FeaturedCard.ShowPlaceholder}"
                             FontSize="12" LetterSpacing="2" Foreground="#8DA5BD"
                             HorizontalAlignment="Center" VerticalAlignment="Bottom"
                             Margin="0,0,0,26"/>
                </Grid>
              </Border>
            </Grid>
          </Grid>
        </Border>

        <Border IsVisible="{Binding IsEmpty}" Height="320"
                CornerRadius="14" Background="#17273A"
                BorderBrush="#32465A" BorderThickness="1" Padding="48">
          <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center"
                      Spacing="16">
            <TextBlock Text="你的家庭影院，從這裡開始" FontSize="30"
                       FontWeight="SemiBold" HorizontalAlignment="Center"/>
            <TextBlock Text="拖曳影片或完整 BDMV 資料夾，建立個人影視收藏。"
                       FontSize="15" Foreground="#B3C2D1"
                       HorizontalAlignment="Center"/>
            <Button Classes="bp-primary" Content="＋ 匯入第一部影片"
                    Click="Import_Click" HorizontalAlignment="Center"/>
          </StackPanel>
        </Border>

        <!-- User-curated, independent of playback progress and imports. -->
        <StackPanel Spacing="12" IsVisible="{Binding HasFavorites}">
          <Grid ColumnDefinitions="*,Auto">
            <TextBlock Text="我的最愛" FontSize="25" FontWeight="SemiBold"
                       AutomationProperties.AutomationId="Lapis.Library.FavoritesHeading"/>
            <Button Grid.Column="1" Classes="bp-secondary"
                    Content="查看全部 ★" Click="Favorites_Click"
                    AutomationProperties.AutomationId="Lapis.Library.ViewFavorites"/>
          </Grid>
          <ScrollViewer HorizontalScrollBarVisibility="Auto"
                        VerticalScrollBarVisibility="Disabled">
            <ItemsControl ItemsSource="{Binding FavoriteItems}">
              <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                  <StackPanel Orientation="Horizontal"/>
                </ItemsPanelTemplate>
              </ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <Button Classes="bp-tile" Width="230" Height="194"
                          Margin="0,0,14,4" CommandParameter="{Binding}"
                          Click="TilePlay_Click" GotFocus="TileGotFocus"
                          PointerEntered="TilePointerEntered"
                          AutomationProperties.Name="{Binding Title}">
                    <Grid RowDefinitions="145,*">
                      <Border Background="#243449" CornerRadius="8"
                              ClipToBounds="True">
                        <Grid>
                          <Image Source="{Binding Poster}" Stretch="Uniform"/>
                          <TextBlock Text="{Binding PlaceholderGlyph}" FontSize="64"
                                     Foreground="#647B93"
                                     IsVisible="{Binding ShowPlaceholder}"
                                     HorizontalAlignment="Center" VerticalAlignment="Center"/>
                          <Border Background="#E6122538" HorizontalAlignment="Right"
                                  VerticalAlignment="Top" CornerRadius="5"
                                  Padding="8,3" Margin="8">
                            <TextBlock Text="★" FontSize="16" Foreground="#FFE1A4"/>
                          </Border>
                        </Grid>
                      </Border>
                      <TextBlock Grid.Row="1" Text="{Binding Title}" Margin="9,6"
                                 FontSize="14" TextTrimming="CharacterEllipsis"
                                 Foreground="#F0F5FA" VerticalAlignment="Center"/>
                    </Grid>
                  </Button>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </ScrollViewer>
        </StackPanel>

        <!-- Resumable local files, sorted by the last viewing session. -->
        <StackPanel Spacing="12" IsVisible="{Binding HasContinueWatching}">
          <TextBlock Text="繼續觀看" FontSize="25" FontWeight="SemiBold"
                     AutomationProperties.AutomationId="Lapis.Library.ContinueWatchingHeading"/>
          <ScrollViewer HorizontalScrollBarVisibility="Auto"
                        VerticalScrollBarVisibility="Disabled">
            <ItemsControl ItemsSource="{Binding ContinueWatchingItems}">
              <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                  <StackPanel Orientation="Horizontal"/>
                </ItemsPanelTemplate>
              </ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <Button Classes="bp-tile" Width="294" Height="212"
                          Margin="0,0,15,4" CommandParameter="{Binding}"
                          Click="TilePlay_Click" GotFocus="TileGotFocus"
                          PointerEntered="TilePointerEntered"
                          AutomationProperties.Name="{Binding Title}">
                    <Grid RowDefinitions="149,4,*">
                      <Border Grid.Row="0" CornerRadius="8" Background="#243449"
                              ClipToBounds="True">
                        <Grid>
                          <Image Source="{Binding Poster}" Stretch="Uniform"/>
                          <TextBlock Text="{Binding PlaceholderGlyph}" FontSize="64"
                                     IsVisible="{Binding ShowPlaceholder}"
                                     Foreground="#647B93"
                                     HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Grid>
                      </Border>
                      <ProgressBar Grid.Row="1" Minimum="0" Maximum="100"
                                   Height="4" Value="{Binding ProgressPercent}"
                                   Foreground="#B7E7FA" Background="#314256"
                                   IsHitTestVisible="False"/>
                      <StackPanel Grid.Row="2" Margin="10,5" Spacing="2">
                        <TextBlock Text="{Binding Title}" FontSize="14"
                                   FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                        <TextBlock Text="{Binding ProgressLabel}" FontSize="11"
                                   Foreground="#AFC9D9" TextTrimming="CharacterEllipsis"/>
                      </StackPanel>
                    </Grid>
                  </Button>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </ScrollViewer>
        </StackPanel>

        <!-- A separate activity shelf: completed films remain visible, but
             cannot masquerade as resumable playback bookmarks. -->
        <StackPanel Spacing="12" IsVisible="{Binding HasRecentlyWatched}">
          <Grid ColumnDefinitions="*,Auto">
            <TextBlock Text="最近觀看" FontSize="25" FontWeight="SemiBold"
                       AutomationProperties.AutomationId="Lapis.Library.HistoryHeading"/>
            <Button Grid.Column="1" Classes="bp-secondary"
                    Content="查看觀看紀錄 →" Click="History_Click"
                    AutomationProperties.AutomationId="Lapis.Library.ViewHistory"/>
          </Grid>
          <ScrollViewer HorizontalScrollBarVisibility="Auto"
                        VerticalScrollBarVisibility="Disabled">
            <ItemsControl ItemsSource="{Binding RecentlyWatchedItems}">
              <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                  <StackPanel Orientation="Horizontal"/>
                </ItemsPanelTemplate>
              </ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <Button Classes="bp-tile" Width="230" Height="194"
                          Margin="0,0,14,4" CommandParameter="{Binding}"
                          Click="TilePlay_Click" GotFocus="TileGotFocus"
                          PointerEntered="TilePointerEntered"
                          AutomationProperties.Name="{Binding Title}">
                    <Grid RowDefinitions="145,*">
                      <Border Background="#243449" CornerRadius="8" ClipToBounds="True">
                        <Grid>
                          <Image Source="{Binding Poster}" Stretch="Uniform"/>
                          <TextBlock Text="{Binding PlaceholderGlyph}" FontSize="64" Foreground="#647B93"
                                     IsVisible="{Binding ShowPlaceholder}"
                                     HorizontalAlignment="Center" VerticalAlignment="Center"/>
                          <Border Background="#D1122538" HorizontalAlignment="Right"
                                  VerticalAlignment="Top" CornerRadius="5" Padding="9,4" Margin="8">
                            <TextBlock Text="{Binding HistoryLabel}"
                                       Foreground="#E1F5FF" FontSize="11"/>
                          </Border>
                        </Grid>
                      </Border>
                      <TextBlock Grid.Row="1" Text="{Binding Title}" Margin="9,6"
                                 FontSize="14" TextTrimming="CharacterEllipsis"
                                 Foreground="#F0F5FA" VerticalAlignment="Center"/>
                    </Grid>
                  </Button>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </ScrollViewer>
        </StackPanel>

        <Grid ColumnDefinitions="*,Auto" IsVisible="{Binding ShowRecentShelf}">
          <StackPanel>
            <TextBlock Text="最近加入" FontSize="25" FontWeight="SemiBold"/>
            <TextBlock Text="接續探索你的電影收藏" Foreground="#95A8BB"
                       FontSize="13" Margin="0,6,0,0"/>
          </StackPanel>
          <TextBlock Grid.Column="1" Text="{Binding CountText}" FontSize="12"
                     Foreground="#8DA4BB" VerticalAlignment="Center"/>
        </Grid>

        <ScrollViewer x:Name="BigPictureRecentStrip"
                      IsVisible="{Binding ShowRecentShelf}"
                      HorizontalScrollBarVisibility="Auto"
                      VerticalScrollBarVisibility="Disabled">
          <ItemsControl ItemsSource="{Binding RecentItems}">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate>
                <StackPanel Orientation="Horizontal"/>
              </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <Button Classes="bp-tile" Width="294" Height="190"
                        Margin="0,0,15,4" CommandParameter="{Binding}"
                        Click="TilePlay_Click"
                        PointerEntered="TilePointerEntered"
                        GotFocus="TileGotFocus"
                        AutomationProperties.Name="{Binding Title}">
                  <Button.ContextMenu>
                    <ContextMenu>
                      <MenuItem Header="▶ 播放" Click="ContextPlay_Click"
                                CommandParameter="{Binding}"/>
                      <MenuItem Header="☷ 管理收藏" Click="ContextManage_Click"/>
                    </ContextMenu>
                  </Button.ContextMenu>
                  <Grid RowDefinitions="154,*">
                    <Border Grid.Row="0" ClipToBounds="True"
                            Background="#243449" CornerRadius="8">
                      <Grid>
                        <Image Source="{Binding Poster}" Stretch="Uniform"/>
                        <TextBlock Text="{Binding PlaceholderGlyph}" IsVisible="{Binding ShowPlaceholder}"
                                   FontSize="64" Foreground="#647B93"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"/>
                        <Border Background="#C40B1623" HorizontalAlignment="Left"
                                VerticalAlignment="Top" CornerRadius="4"
                                Margin="9" Padding="7,3">
                          <TextBlock Text="{Binding KindLabel}" FontSize="10"
                                     Foreground="#D9ECF7"/>
                        </Border>
                      </Grid>
                    </Border>
                    <TextBlock Grid.Row="1" Text="{Binding Title}" Margin="10,5"
                               TextTrimming="CharacterEllipsis" FontSize="14"
                               Foreground="#EDF5FC" VerticalAlignment="Center"
                               FontWeight="Medium"/>
                  </Grid>
                </Button>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </ScrollViewer>

        <Grid ColumnDefinitions="*,Auto" Margin="0,8,0,0">
          <TextBlock Text="{Binding CurrentFilterLabel}"
                     FontSize="25" FontWeight="SemiBold"
                     VerticalAlignment="Center"/>
          <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="10">
            <ComboBox ItemsSource="{Binding SortOptions}"
                      SelectedItem="{Binding SelectedSort, Mode=TwoWay}"
                      Width="140" Height="40">
              <ComboBox.ItemTemplate>
                <DataTemplate>
                  <TextBlock Text="{Binding Label}"/>
                </DataTemplate>
              </ComboBox.ItemTemplate>
            </ComboBox>
            <TextBox Text="{Binding SearchText, Mode=TwoWay}"
                     Watermark="搜尋電影或路徑" Width="250" Height="40"
                     Background="#19283B" CornerRadius="8"
                     Foreground="#F4F7FA" BorderBrush="#39516A"/>
          </StackPanel>
        </Grid>

        <TextBlock Text="這個分類目前沒有相符的影片。"
                   IsVisible="{Binding HasNoResults}" FontSize="15"
                   Foreground="#A9BED0" Margin="0,16"/>

        <ItemsControl ItemsSource="{Binding VisibleItems}">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
              <WrapPanel Orientation="Horizontal"/>
            </ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <Button Classes="bp-tile" Width="238" Height="174"
                      Margin="0,0,14,15" CommandParameter="{Binding}"
                      Click="TilePlay_Click"
                      PointerEntered="TilePointerEntered"
                      GotFocus="TileGotFocus"
                      AutomationProperties.Name="{Binding Title}">
                <Button.ContextMenu>
                  <ContextMenu>
                    <MenuItem Header="▶ 播放" Click="ContextPlay_Click"
                              CommandParameter="{Binding}"/>
                    <MenuItem Header="☷ 管理收藏" Click="ContextManage_Click"/>
                  </ContextMenu>
                </Button.ContextMenu>
                <Grid RowDefinitions="137,*">
                  <Border Grid.Row="0" Background="#25364A" CornerRadius="7"
                          ClipToBounds="True">
                    <Grid>
                      <Image Source="{Binding Poster}" Stretch="Uniform"/>
                      <TextBlock Text="{Binding PlaceholderGlyph}" FontSize="52"
                                 IsVisible="{Binding ShowPlaceholder}"
                                 HorizontalAlignment="Center"
                                 VerticalAlignment="Center" Foreground="#617992"/>
                      <Border HorizontalAlignment="Left" VerticalAlignment="Top"
                              Background="#CA122437" Padding="5,3"
                              CornerRadius="3" Margin="8">
                        <TextBlock Text="{Binding KindLabel}" FontSize="9"
                                   Foreground="#E4F0F9"/>
                      </Border>
                    </Grid>
                  </Border>
                  <TextBlock Grid.Row="1" Text="{Binding Title}"
                             Margin="9,4" TextTrimming="CharacterEllipsis"
                             Foreground="#F0F4F8" FontSize="13"
                             VerticalAlignment="Center"/>
                </Grid>
              </Button>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </StackPanel>
    </ScrollViewer>

    <Border Grid.Row="1" BorderBrush="#2D4053" BorderThickness="0,1,0,0"
            Background="#F009121E" Padding="35,8">
      <Grid ColumnDefinitions="*,Auto">
        <TextBlock Text="{Binding StatusText}" Foreground="#8FA2B6"
                   FontSize="12" TextTrimming="CharacterEllipsis"
                   VerticalAlignment="Center"/>
        <TextBlock Grid.Column="1"
                   Text="手把：方向鍵選片 · A 詳情／確認 · B 返回 · LB/RB 切分類 · Menu 管理   ｜   鍵盤：方向鍵／Enter／Esc"
                   Foreground="#AEC0CF" FontSize="12"
                   VerticalAlignment="Center"/>
      </Grid>
    </Border>
    <!-- Cinematic detail sheet: inspect a film before committing to playback. -->
    <Grid x:Name="BigPictureDetailsOverlay" Grid.RowSpan="2" ZIndex="80"
          IsVisible="False" Background="#E90A111C"
          AutomationProperties.AutomationId="Lapis.Library.DetailOverlay">
      <Border Background="#132235" BorderBrush="#3D566D" BorderThickness="1"
              CornerRadius="18" Padding="44" Margin="35" MaxWidth="1050"
              VerticalAlignment="Center" HorizontalAlignment="Center">
        <Grid ColumnDefinitions="*,328" ColumnSpacing="28" MinHeight="380">
          <StackPanel Grid.Column="0" VerticalAlignment="Center" Spacing="16">
            <TextBlock Text="你的電影收藏" FontSize="12" FontWeight="SemiBold"
                       Foreground="#9DDDEE" LetterSpacing="2"/>
            <TextBlock Text="{Binding FeaturedCard.Title}" FontSize="36"
                       FontWeight="SemiBold" TextWrapping="Wrap"
                       MaxLines="3" Foreground="#F7FAFD"/>
            <StackPanel Orientation="Horizontal" Spacing="15">
              <TextBlock Text="{Binding FeaturedCard.KindLabel}" FontSize="14"
                         Foreground="#C4EAF6"/>
              <TextBlock Text="{Binding FeaturedCard.AvailabilityLabel}"
                         Foreground="#AFC2D1" FontSize="14"/>
            </StackPanel>
            <TextBlock Text="收藏資訊" FontSize="15" FontWeight="Medium"
                       Margin="0,12,0,0" Foreground="#F0F5FA"/>
            <StackPanel Orientation="Horizontal" Spacing="12">
              <TextBlock Text="加入日期" FontSize="13" Foreground="#99AEC0"/>
              <TextBlock Text="{Binding FeaturedCard.ImportedAtText}"
                         FontSize="13" Foreground="#D9E8F3"/>
            </StackPanel>
            <TextBlock Text="{Binding FeaturedCard.LastWatchedLabel}"
                       IsVisible="{Binding FeaturedCard.HasWatchHistory}"
                       Foreground="#A8BDCE" FontSize="13"/>
            <TextBlock Text="本機海報支援：影片同名 .poster.jpg／.jpg／.png，或單片資料夾內的 folder.jpg"
                       TextWrapping="Wrap" FontSize="11" Foreground="#7393A9"
                       IsVisible="{Binding FeaturedCard.ShowPlaceholder}"/>
            <TextBlock Text="{Binding FeaturedCard.HistoryLabel}"
                       IsVisible="{Binding FeaturedCard.HasWatchHistory}"
                       Foreground="#9DDDEE" FontSize="14"/>
            <TextBlock Text="{Binding FeaturedCard.ProgressLabel}"
                       IsVisible="{Binding FeaturedCard.CanResume}"
                       Foreground="#B7E7FA" FontSize="14"/>
            <TextBlock Text="資訊來自本機電影庫，沒有擅自下載外部電影資料。"
                       TextWrapping="Wrap" FontSize="12"
                       Foreground="#8FA5B8" MaxWidth="490"/>
            <Button Classes="bp-secondary" Content="{Binding FeaturedCard.FavoriteActionLabel}"
                    HorizontalAlignment="Left"
                    Click="DetailsFavorite_Click"
                    AutomationProperties.AutomationId="Lapis.Library.DetailFavorite"
                    AutomationProperties.Name="{Binding FeaturedCard.FavoriteActionLabel}"/>
            <!-- Sidecar artwork refresh works without restarting Lapis or playback. -->
            <StackPanel Orientation="Horizontal" Spacing="12" Margin="0,5,0,0">
              <Button Classes="bp-secondary" Content="⟳  重新掃描封面"
                      Click="DetailsRefreshPoster_Click"
                      IsEnabled="{Binding FeaturedCard.CanRefreshPoster}"
                      AutomationProperties.AutomationId="Lapis.Library.DetailRefreshPoster"
                      AutomationProperties.Name="重新掃描此電影的本機封面"/>
              <TextBlock Text="{Binding FeaturedCard.PosterRefreshStatus}"
                         AutomationProperties.AutomationId="Lapis.Library.PosterRefreshStatus"
                         FontSize="12" Foreground="#A7D9E7"
                         VerticalAlignment="Center" TextWrapping="Wrap"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" Spacing="12" Margin="0,18,0,0">
              <Button x:Name="BigPictureDetailsResume" Classes="bp-primary"
                      Content="▶  繼續播放" Click="DetailsResume_Click"
                      IsVisible="{Binding FeaturedCard.CanResume}"
                      AutomationProperties.AutomationId="Lapis.Library.DetailResume"
                      AutomationProperties.Name="從上次觀影進度繼續播放"/>
              <Button x:Name="BigPictureDetailsPlay" Classes="bp-secondary"
                      Content="從頭播放" Click="DetailsPlay_Click"
                      IsEnabled="{Binding FeaturedCard.IsAvailable}"
                      AutomationProperties.AutomationId="Lapis.Library.DetailPlay"
                      AutomationProperties.Name="播放目前選取的電影"/>
              <Button Classes="bp-secondary" Content="移除觀看紀錄"
                      Click="DetailsForget_Click"
                      IsVisible="{Binding FeaturedCard.HasWatchHistory}"
                      AutomationProperties.AutomationId="Lapis.Library.DetailForget"
                      AutomationProperties.Name="移除此電影的觀看紀錄與續播位置"/>
              <Button Classes="bp-secondary" Content="返回收藏庫"
                      Click="DetailsClose_Click"
                      AutomationProperties.AutomationId="Lapis.Library.DetailClose"
                      AutomationProperties.Name="關閉電影詳細資訊"/>
            </StackPanel>
          </StackPanel>
          <Border Grid.Column="1" Width="328" Height="328" CornerRadius="12"
                  Background="#243448" ClipToBounds="True"
                  VerticalAlignment="Center">
            <Grid>
              <Image Source="{Binding FeaturedCard.Poster}" Stretch="Uniform"/>
              <TextBlock Text="{Binding FeaturedCard.PlaceholderGlyph}" IsVisible="{Binding FeaturedCard.ShowPlaceholder}"
                         FontSize="85" Foreground="#637D96"
                         HorizontalAlignment="Center" VerticalAlignment="Center"/>
              <TextBlock Text="{Binding FeaturedCard.PlaceholderCaption}"
                         IsVisible="{Binding FeaturedCard.ShowPlaceholder}"
                         FontSize="12" LetterSpacing="2" Foreground="#9BB1C5"
                         HorizontalAlignment="Center" VerticalAlignment="Bottom"
                         Margin="0,0,0,35"/>
            </Grid>
          </Border>
        </Grid>
      </Border>
    </Grid>
  </Grid>
</UserControl>
