<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="Lapis.Desktop.Avalonia.Views.BigPictureLibraryView"
             Background="#090D14" Foreground="#F6F2EC"
             Focusable="True">
  <UserControl.Styles>
    <Style Selector="Button.bp-nav">
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="Foreground" Value="#AAB4C1"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="CornerRadius" Value="8"/>
      <Setter Property="Padding" Value="20,12"/>
      <Setter Property="FontSize" Value="17"/>
      <Setter Property="Transitions">
        <Transitions>
          <BrushTransition Property="Background" Duration="0:0:0.16"/>
          <BrushTransition Property="Foreground" Duration="0:0:0.16"/>
        </Transitions>
      </Setter>
    </Style>
    <Style Selector="Button.bp-nav:pointerover, Button.bp-nav:focus-visible">
      <Setter Property="Foreground" Value="#FFF6E9"/>
      <Setter Property="Background" Value="#28394E"/>
    </Style>
    <Style Selector="Button.bp-nav.selected">
      <Setter Property="Foreground" Value="#FFFFFF"/>
      <Setter Property="Background" Value="#32475F"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
    </Style>
    <Style Selector="Button.bp-tile">
      <Setter Property="Background" Value="#151D2A"/>
      <Setter Property="BorderBrush" Value="#34475D"/>
      <Setter Property="BorderThickness" Value="2"/>
      <Setter Property="CornerRadius" Value="10"/>
      <Setter Property="Padding" Value="0"/>
      <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
      <Setter Property="VerticalContentAlignment" Value="Stretch"/>
      <Setter Property="Transitions">
        <Transitions>
          <BrushTransition Property="Background" Duration="0:0:0.18"/>
          <BrushTransition Property="BorderBrush" Duration="0:0:0.18"/>
        </Transitions>
      </Setter>
    </Style>
    <Style Selector="Button.bp-tile:pointerover, Button.bp-tile:focus-visible">
      <Setter Property="Background" Value="#31445B"/>
      <Setter Property="BorderBrush" Value="#F0C58C"/>
      <Setter Property="BorderThickness" Value="3"/>
    </Style>
    <Style Selector="Button.bp-primary">
      <Setter Property="Background" Value="#F0C58C"/>
      <Setter Property="Foreground" Value="#24190E"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="CornerRadius" Value="8"/>
      <Setter Property="Padding" Value="25,13"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="FontSize" Value="16"/>
    </Style>
    <Style Selector="Button.bp-primary:pointerover">
      <Setter Property="Background" Value="#FFE0B3"/>
    </Style>
    <Style Selector="Button.bp-secondary">
      <Setter Property="Background" Value="#6B253A4B"/>
      <Setter Property="Foreground" Value="#F5F0E9"/>
      <Setter Property="BorderBrush" Value="#526579"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="CornerRadius" Value="8"/>
      <Setter Property="Padding" Value="18,12"/>
    </Style>
    <Style Selector="Button.bp-secondary:pointerover">
      <Setter Property="Background" Value="#3C5369"/>
    </Style>
    <Style Selector="Button.bp-mode">
      <Setter Property="Background" Value="#182335"/>
      <Setter Property="Foreground" Value="#A9B6C6"/>
      <Setter Property="BorderBrush" Value="#354459"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="CornerRadius" Value="10"/>
      <Setter Property="Padding" Value="14,10"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Cursor" Value="Hand"/>
    </Style>
    <Style Selector="Button.bp-mode.active">
      <Setter Property="Background" Value="#3C342F"/>
      <Setter Property="Foreground" Value="#FFD99F"/>
      <Setter Property="BorderBrush" Value="#E9B879"/>
    </Style>
    <Style Selector="Button.bp-mode:pointerover, Button.bp-mode:focus-visible">
      <Setter Property="BorderBrush" Value="#F0C58C"/>
      <Setter Property="Foreground" Value="#FFFFFF"/>
    </Style>
    <Style Selector="Button.bp-list-row">
      <Setter Property="Background" Value="#182332"/>
      <Setter Property="BorderBrush" Value="#2C3C50"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="CornerRadius" Value="10"/>
      <Setter Property="Padding" Value="12,8"/>
      <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
      <Setter Property="Margin" Value="0,0,0,4"/>
    </Style>
    <Style Selector="Button.bp-list-row:pointerover, Button.bp-list-row:focus-visible">
      <Setter Property="Background" Value="#2B3B4D"/>
      <Setter Property="BorderBrush" Value="#F0C58C"/>
      <Setter Property="BorderThickness" Value="1"/>
    </Style>
  </UserControl.Styles>
  <Grid x:Name="BigPictureRoot" AutomationProperties.AutomationId="Lapis.Library.Root" RowDefinitions="*,52"
        Background="#090D14">

    <ScrollViewer Grid.Row="0" x:Name="BigPictureScroll"
                  HorizontalScrollBarVisibility="Disabled"
                  VerticalScrollBarVisibility="Auto">
      <StackPanel Spacing="25" Margin="38,26,38,42">

        <!-- Hero backdrop is sourced only from user-imported media artwork.
             It is not a fictitious poster or an external metadata scrape. -->
        <Border x:Name="BigPictureHero" AutomationProperties.AutomationId="Lapis.Library.Hero" Height="310" ClipToBounds="True"
                CornerRadius="22" Background="#18263A"
                BorderBrush="#3A4C61" BorderThickness="1"
                IsVisible="{Binding ShowFeaturedHero}">
          <Grid>
            <Image Source="{Binding FeaturedCard.Poster}" Stretch="UniformToFill"
                   Opacity="0.45"/>
            <Border Background="#9A0B1726"/>
            <Grid ColumnDefinitions="*,392" Margin="38,26,28,26"
                  ColumnSpacing="24">
              <StackPanel VerticalAlignment="Center" Spacing="10">
                <TextBlock Text="TONIGHT AT LAPIS" FontSize="12"
                           LetterSpacing="2" FontWeight="Bold"
                           Foreground="#F3C688"/>
                <TextBlock Text="{Binding FeaturedCard.Title}" FontSize="38"
                           FontWeight="SemiBold" Foreground="#FFFFFF"
                           TextTrimming="CharacterEllipsis" MaxLines="2"
                           TextWrapping="Wrap"/>
                <TextBlock Text="{Binding FeaturedCard.AvailabilityLabel}"
                           FontSize="13" Foreground="#B6C6D5"/>
                <StackPanel Orientation="Horizontal" Spacing="12" Margin="0,15,0,0">
                  <Button Classes="bp-primary" Content="{Binding FeaturedCard.PlayActionLabel}"
                          IsEnabled="{Binding FeaturedCard.IsAvailable}"
                          AutomationProperties.AutomationId="Lapis.Library.PlayFeatured"
                          Click="FeaturedPlay_Click" AutomationProperties.Name="播放選中影片"/>
                  <Button Classes="bp-secondary" Content="更多資訊"
                          Click="FeaturedDetails_Click"
                          AutomationProperties.AutomationId="Lapis.Library.FeaturedDetails"
                          AutomationProperties.Name="檢視精選電影詳細資訊"/>
                </StackPanel>
              </StackPanel>
              <Border Grid.Column="1" Width="392" Height="222"
                      Background="#243448" CornerRadius="10"
                      ClipToBounds="True" VerticalAlignment="Center"
                      BorderBrush="#5E7488" BorderThickness="1">
                <Grid>
                  <Image Source="{Binding FeaturedCard.Poster}"
                         Stretch="Uniform"/>
                  <TextBlock Text="{Binding FeaturedCard.PlaceholderGlyph}" FontSize="92" FontWeight="Light"
                             HorizontalAlignment="Center" VerticalAlignment="Center"
                             Foreground="#506A81"
                             IsVisible="{Binding FeaturedCard.ShowPlaceholder}"/>
                  <TextBlock Text="{Binding FeaturedCard.PlaceholderCaption}"
                             IsVisible="{Binding FeaturedCard.ShowPlaceholder}"
                             FontSize="12" LetterSpacing="2" Foreground="#8DA5BD"
                             HorizontalAlignment="Center" VerticalAlignment="Bottom"
                             Margin="0,0,0,26"/>
                </Grid>
              </Border>
            </Grid>
          </Grid>
        </Border>

        <Border IsVisible="{Binding IsEmpty}" Height="320"
                CornerRadius="14" Background="#151F2E"
                BorderBrush="#304258" BorderThickness="1" Padding="48">
          <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center"
                      Spacing="16">
            <TextBlock Text="你的家庭影院，從這裡開始" FontSize="30"
                       FontWeight="SemiBold" HorizontalAlignment="Center"/>
            <TextBlock Text="拖曳影片或完整 BDMV 資料夾，建立個人影視收藏。"
                       FontSize="15" Foreground="#B3C2D1"
                       HorizontalAlignment="Center"/>
            <Button Classes="bp-primary" Content="＋ 匯入第一部影片"
                    Click="Import_Click" HorizontalAlignment="Center"/>
          </StackPanel>
        </Border>

        <!-- User-curated, independent of playback progress and imports. -->
        <StackPanel Spacing="12" IsVisible="{Binding ShowFavoritesShelf}">
          <Grid ColumnDefinitions="*,Auto">
            <TextBlock Text="我的最愛" FontSize="25" FontWeight="SemiBold"
                       AutomationProperties.AutomationId="Lapis.Library.FavoritesHeading"/>
            <Button Grid.Column="1" Classes="bp-secondary"
                    Content="查看全部 ★" Click="Favorites_Click"
                    AutomationProperties.AutomationId="Lapis.Library.ViewFavorites"/>
          </Grid>
          <ScrollViewer HorizontalScrollBarVisibility="Auto"
                        VerticalScrollBarVisibility="Disabled">
            <ItemsControl ItemsSource="{Binding FavoriteItems}">
              <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                  <StackPanel Orientation="Horizontal"/>
                </ItemsPanelTemplate>
              </ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <Button Classes="bp-tile" Width="230" Height="194"
                          Margin="0,0,14,4" CommandParameter="{Binding}"
                          Click="TilePlay_Click" GotFocus="TileGotFocus"
                          PointerEntered="TilePointerEntered"
                          AutomationProperties.Name="{Binding Title}">
                    <Grid RowDefinitions="145,*">
                      <Border Background="#222E40" CornerRadius="8"
                              ClipToBounds="True">
                        <Grid>
                          <Image Source="{Binding Poster}" Stretch="Uniform"/>
                          <TextBlock Text="{Binding PlaceholderGlyph}" FontSize="64"
                                     Foreground="#647B93"
                                     IsVisible="{Binding ShowPlaceholder}"
                                     HorizontalAlignment="Center" VerticalAlignment="Center"/>
                          <Border Background="#E6122538" HorizontalAlignment="Right"
                                  VerticalAlignment="Top" CornerRadius="5"
                                  Padding="8,3" Margin="8">
                            <TextBlock Text="★" FontSize="16" Foreground="#FFE1A4"/>
                          </Border>
                        </Grid>
                      </Border>
                      <TextBlock Grid.Row="1" Text="{Binding Title}" Margin="9,6"
                                 FontSize="14" TextTrimming="CharacterEllipsis"
                                 Foreground="#F6F2EC" VerticalAlignment="Center"/>
                    </Grid>
                  </Button>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </ScrollViewer>
        </StackPanel>

        <!-- Resumable local files, sorted by the last viewing session. -->
        <StackPanel Spacing="12" IsVisible="{Binding ShowContinueShelf}">
          <TextBlock Text="繼續觀看" FontSize="25" FontWeight="SemiBold"
                     AutomationProperties.AutomationId="Lapis.Library.ContinueWatchingHeading"/>
          <ScrollViewer HorizontalScrollBarVisibility="Auto"
                        VerticalScrollBarVisibility="Disabled">
            <ItemsControl ItemsSource="{Binding ContinueWatchingItems}">
              <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                  <StackPanel Orientation="Horizontal"/>
                </ItemsPanelTemplate>
              </ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <Button Classes="bp-tile" Width="294" Height="212"
                          Margin="0,0,15,4" CommandParameter="{Binding}"
                          Click="TilePlay_Click" GotFocus="TileGotFocus"
                          PointerEntered="TilePointerEntered"
                          AutomationProperties.Name="{Binding Title}">
                    <Grid RowDefinitions="149,4,*">
                      <Border Grid.Row="0" CornerRadius="8" Background="#222E40"
                              ClipToBounds="True">
                        <Grid>
                          <Image Source="{Binding Poster}" Stretch="Uniform"/>
                          <TextBlock Text="{Binding PlaceholderGlyph}" FontSize="64"
                                     IsVisible="{Binding ShowPlaceholder}"
                                     Foreground="#647B93"
                                     HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Grid>
                      </Border>
                      <ProgressBar Grid.Row="1" Minimum="0" Maximum="100"
                                   Height="4" Value="{Binding ProgressPercent}"
                                   Foreground="#F0C58C" Background="#314256"
                                   IsHitTestVisible="False"/>
                      <StackPanel Grid.Row="2" Margin="10,5" Spacing="2">
                        <TextBlock Text="{Binding Title}" FontSize="14"
                                   FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                        <TextBlock Text="{Binding ProgressLabel}" FontSize="11"
                                   Foreground="#AFC9D9" TextTrimming="CharacterEllipsis"/>
                      </StackPanel>
                    </Grid>
                  </Button>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </ScrollViewer>
        </StackPanel>

        <!-- A separate activity shelf: completed films remain visible, but
             cannot masquerade as resumable playback bookmarks. -->
        <StackPanel Spacing="12" IsVisible="{Binding ShowHistoryShelf}">
          <Grid ColumnDefinitions="*,Auto">
            <TextBlock Text="最近觀看" FontSize="25" FontWeight="SemiBold"
                       AutomationProperties.AutomationId="Lapis.Library.HistoryHeading"/>
            <Button Grid.Column="1" Classes="bp-secondary"
                    Content="查看觀看紀錄 →" Click="History_Click"
                    AutomationProperties.AutomationId="Lapis.Library.ViewHistory"/>
          </Grid>
          <ScrollViewer HorizontalScrollBarVisibility="Auto"
                        VerticalScrollBarVisibility="Disabled">
            <ItemsControl ItemsSource="{Binding RecentlyWatchedItems}">
              <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                  <StackPanel Orientation="Horizontal"/>
                </ItemsPanelTemplate>
              </ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <Button Classes="bp-tile" Width="230" Height="194"
                          Margin="0,0,14,4" CommandParameter="{Binding}"
                          Click="TilePlay_Click" GotFocus="TileGotFocus"
                          PointerEntered="TilePointerEntered"
                          AutomationProperties.Name="{Binding Title}">
                    <Grid RowDefinitions="145,*">
                      <Border Background="#222E40" CornerRadius="8" ClipToBounds="True">
                        <Grid>
                          <Image Source="{Binding Poster}" Stretch="Uniform"/>
                          <TextBlock Text="{Binding PlaceholderGlyph}" FontSize="64" Foreground="#647B93"
                                     IsVisible="{Binding ShowPlaceholder}"
                                     HorizontalAlignment="Center" VerticalAlignment="Center"/>
                          <Border Background="#D1122538" HorizontalAlignment="Right"
                                  VerticalAlignment="Top" CornerRadius="5" Padding="9,4" Margin="8">
                            <TextBlock Text="{Binding HistoryLabel}"
                                       Foreground="#E1F5FF" FontSize="11"/>
                          </Border>
                        </Grid>
                      </Border>
                      <TextBlock Grid.Row="1" Text="{Binding Title}" Margin="9,6"
                                 FontSize="14" TextTrimming="CharacterEllipsis"
                                 Foreground="#F6F2EC" VerticalAlignment="Center"/>
                    </Grid>
                  </Button>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </ScrollViewer>
        </StackPanel>

        <Grid ColumnDefinitions="*,Auto" IsVisible="{Binding ShowRecentShelf}">
          <StackPanel>
            <TextBlock Text="最近加入" FontSize="25" FontWeight="SemiBold"/>
            <TextBlock Text="接續探索你的電影收藏" Foreground="#95A8BB"
                       FontSize="13" Margin="0,6,0,0"/>
          </StackPanel>
          <TextBlock Grid.Column="1" Text="{Binding CountText}" FontSize="12"
                     Foreground="#8DA4BB" VerticalAlignment="Center"/>
        </Grid>

        <ScrollViewer x:Name="BigPictureRecentStrip"
                      IsVisible="{Binding ShowRecentShelf}"
                      HorizontalScrollBarVisibility="Auto"
                      VerticalScrollBarVisibility="Disabled">
          <ItemsControl ItemsSource="{Binding RecentItems}">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate>
                <StackPanel Orientation="Horizontal"/>
              </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <Button Classes="bp-tile" Width="294" Height="190"
                        Margin="0,0,15,4" CommandParameter="{Binding}"
                        Click="TilePlay_Click"
                        PointerEntered="TilePointerEntered"
                        GotFocus="TileGotFocus"
                        AutomationProperties.Name="{Binding Title}">
                  <Button.ContextMenu>
                    <ContextMenu>
                      <MenuItem Header="▶ 播放" Click="ContextPlay_Click"
                                CommandParameter="{Binding}"/>
                      <MenuItem Header="檢視與管理" Click="ContextManage_Click" CommandParameter="{Binding}"/>
                    </ContextMenu>
                  </Button.ContextMenu>
                  <Grid RowDefinitions="154,*">
                    <Border Grid.Row="0" ClipToBounds="True"
                            Background="#222E40" CornerRadius="8">
                      <Grid>
                        <Image Source="{Binding Poster}" Stretch="Uniform"/>
                        <TextBlock Text="{Binding PlaceholderGlyph}" IsVisible="{Binding ShowPlaceholder}"
                                   FontSize="64" Foreground="#647B93"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"/>
                        <Border Background="#C40B1623" HorizontalAlignment="Left"
                                VerticalAlignment="Top" CornerRadius="4"
                                Margin="9" Padding="7,3">
                          <TextBlock Text="{Binding KindLabel}" FontSize="10"
                                     Foreground="#D9ECF7"/>
                        </Border>
                      </Grid>
                    </Border>
                    <TextBlock Grid.Row="1" Text="{Binding Title}" Margin="10,5"
                               TextTrimming="CharacterEllipsis" FontSize="14"
                               Foreground="#EDF5FC" VerticalAlignment="Center"
                               FontWeight="Medium"/>
                  </Grid>
                </Button>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </ScrollViewer>

        <Grid ColumnDefinitions="*,Auto" Margin="0,8,0,0">
          <TextBlock Text="{Binding CurrentFilterLabel}"
                     FontSize="25" FontWeight="SemiBold"
                     VerticalAlignment="Center"/>
          <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="10">
            <Button Classes="bp-mode" Classes.active="{Binding IsGridView}"
                    Content="▦ 海報" Click="Grid_Click" Height="42"
                    AutomationProperties.AutomationId="Lapis.Library.GridMode"
                    AutomationProperties.Name="切換海報檢視"/>
            <Button Classes="bp-mode" Classes.active="{Binding IsListView}"
                    Content="☷ 清單" Click="List_Click" Height="42"
                    AutomationProperties.AutomationId="Lapis.Library.ListMode"
                    AutomationProperties.Name="切換清單檢視"/>
            <ComboBox ItemsSource="{Binding SortOptions}"
                      SelectedItem="{Binding SelectedSort, Mode=TwoWay}"
                      Width="152" Height="42">
              <ComboBox.ItemTemplate>
                <DataTemplate>
                  <TextBlock Text="{Binding Label}"/>
                </DataTemplate>
              </ComboBox.ItemTemplate>
            </ComboBox>
            <TextBox Text="{Binding SearchText, Mode=TwoWay}"
                     Watermark="搜尋片名或檔案路徑" Width="248" Height="42"
                     Background="#182436" CornerRadius="8"
                     Foreground="#F7F2EB" BorderBrush="#3B4A60"/>
          </StackPanel>
        </Grid>

        <TextBlock Text="這個分類目前沒有相符的影片。"
                   IsVisible="{Binding HasNoResults}" FontSize="15"
                   Foreground="#A9BED0" Margin="0,16"/>

        <ItemsControl IsVisible="{Binding IsGridView}" ItemsSource="{Binding VisibleItems}">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
              <WrapPanel Orientation="Horizontal"/>
            </ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <Button Classes="bp-tile" Width="238" Height="174"
                      Margin="0,0,14,15" CommandParameter="{Binding}"
                      Click="TilePlay_Click"
                      PointerEntered="TilePointerEntered"
                      GotFocus="TileGotFocus"
                      AutomationProperties.Name="{Binding Title}">
                <Button.ContextMenu>
                  <ContextMenu>
                    <MenuItem Header="▶ 播放" Click="ContextPlay_Click"
                              CommandParameter="{Binding}"/>
                    <MenuItem Header="檢視與管理" Click="ContextManage_Click" CommandParameter="{Binding}"/>
                  </ContextMenu>
                </Button.ContextMenu>
                <Grid RowDefinitions="137,*">
                  <Border Grid.Row="0" Background="#212E41" CornerRadius="7"
                          ClipToBounds="True">
                    <Grid>
                      <Image Source="{Binding Poster}" Stretch="Uniform"/>
                      <TextBlock Text="{Binding PlaceholderGlyph}" FontSize="52"
                                 IsVisible="{Binding ShowPlaceholder}"
                                 HorizontalAlignment="Center"
                                 VerticalAlignment="Center" Foreground="#617992"/>
                      <Border HorizontalAlignment="Left" VerticalAlignment="Top"
                              Background="#CA122437" Padding="5,3"
                              CornerRadius="3" Margin="8">
                        <TextBlock Text="{Binding KindLabel}" FontSize="9"
                                   Foreground="#E4F0F9"/>
                      </Border>
                    </Grid>
                  </Border>
                  <TextBlock Grid.Row="1" Text="{Binding Title}"
                             Margin="9,4" TextTrimming="CharacterEllipsis"
                             Foreground="#F0F4F8" FontSize="13"
                             VerticalAlignment="Center"/>
                </Grid>
              </Button>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
        <!-- Alternative projection over the SAME VisibleItems collection. -->
        <Border IsVisible="{Binding IsListView}" Background="#111924"
                BorderBrush="#334155" BorderThickness="1"
                CornerRadius="14" Padding="12,12,12,8"
                AutomationProperties.AutomationId="Lapis.Library.ListSurface">
          <StackPanel Spacing="10">
            <Grid ColumnDefinitions="64,3*,108,2*,122,126" ColumnSpacing="12"
                  Margin="10,0,10,2">
              <TextBlock Grid.Column="0" Text="封面" Foreground="#91A3B5" FontSize="12"/>
              <TextBlock Grid.Column="1" Text="片名" Foreground="#91A3B5" FontSize="12"/>
              <TextBlock Grid.Column="2" Text="類型" Foreground="#91A3B5" FontSize="12"/>
              <TextBlock Grid.Column="3" Text="來源位置" Foreground="#91A3B5" FontSize="12"/>
              <TextBlock Grid.Column="4" Text="加入日期" Foreground="#91A3B5" FontSize="12"/>
              <TextBlock Grid.Column="5" Text="狀態" Foreground="#91A3B5" FontSize="12"/>
            </Grid>
            <ItemsControl ItemsSource="{Binding VisibleItems}">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <Button Classes="bp-tile bp-list-row"
                          CommandParameter="{Binding}"
                          Click="TilePlay_Click" GotFocus="TileGotFocus"
                          PointerEntered="TilePointerEntered"
                          AutomationProperties.Name="{Binding Title}">
                    <Button.ContextMenu>
                      <ContextMenu>
                        <MenuItem Header="▶ 播放" Click="ContextPlay_Click" CommandParameter="{Binding}"/>
                        <MenuItem Header="檢視與管理" Click="ContextManage_Click" CommandParameter="{Binding}"/>
                      </ContextMenu>
                    </Button.ContextMenu>
                    <Grid ColumnDefinitions="64,3*,108,2*,122,126"
                          ColumnSpacing="12" Height="55">
                      <Border Grid.Column="0" CornerRadius="7" Background="#253247"
                              ClipToBounds="True">
                        <Grid>
                          <Image Source="{Binding Poster}" Stretch="Uniform"/>
                          <TextBlock Text="{Binding PlaceholderGlyph}"
                                     IsVisible="{Binding ShowPlaceholder}"
                                     FontSize="27" Foreground="#647B93"
                                     HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Grid>
                      </Border>
                      <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="4">
                        <TextBlock Text="{Binding Title}" FontSize="14"
                                   FontWeight="SemiBold" Foreground="#F6F2EC"
                                   TextTrimming="CharacterEllipsis"/>
                        <TextBlock Text="{Binding ProgressLabel}" FontSize="11"
                                   Foreground="#9DAEC2" TextTrimming="CharacterEllipsis"/>
                      </StackPanel>
                      <TextBlock Grid.Column="2" Text="{Binding KindLabel}"
                                 VerticalAlignment="Center" FontSize="12"
                                 Foreground="#D0B893" TextTrimming="CharacterEllipsis"/>
                      <TextBlock Grid.Column="3" Text="{Binding SourcePath}"
                                 VerticalAlignment="Center" FontSize="11"
                                 Foreground="#A9B6C7" TextTrimming="CharacterEllipsis"/>
                      <TextBlock Grid.Column="4" Text="{Binding ImportedAtText}"
                                 VerticalAlignment="Center" FontSize="12" Foreground="#B6C2D0"/>
                      <TextBlock Grid.Column="5" Text="{Binding AvailabilityLabel}"
                                 VerticalAlignment="Center" FontSize="11"
                                 Foreground="#D5DDE6" TextTrimming="CharacterEllipsis"/>
                    </Grid>
                  </Button>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>
        </Border>

      </StackPanel>
    </ScrollViewer>

    <Border Grid.Row="1" BorderBrush="#2D4053" BorderThickness="0,1,0,0"
            Background="#EF0C111A" Padding="35,8">
      <Grid ColumnDefinitions="*,Auto">
        <TextBlock Text="{Binding StatusText}" Foreground="#8FA2B6"
                   FontSize="12" TextTrimming="CharacterEllipsis"
                   VerticalAlignment="Center"/>
        <TextBlock Grid.Column="1"
                   Text="手把：方向鍵選片 · A 詳情／確認 · B 返回 · LB/RB 切分類 · Menu 切換檢視   ｜   鍵盤：方向鍵／Enter／Esc"
                   Foreground="#AEC0CF" FontSize="12"
                   VerticalAlignment="Center"/>
      </Grid>
    </Border>
    <!-- Cinematic detail sheet: inspect a film before committing to playback. -->
    <Grid x:Name="BigPictureDetailsOverlay" Grid.RowSpan="2" ZIndex="80"
          IsVisible="False" Background="#ED070B12"
          AutomationProperties.AutomationId="Lapis.Library.DetailOverlay">
      <!-- Detail actions must remain reachable at 580px minimum window height. -->
      <ScrollViewer x:Name="BigPictureDetailsScroll"
                    Margin="24" VerticalScrollBarVisibility="Auto"
                    HorizontalScrollBarVisibility="Disabled">
        <Border Background="#132235" BorderBrush="#3D566D" BorderThickness="1"
                CornerRadius="18" Padding="34" Margin="0,4" MaxWidth="1050"
                HorizontalAlignment="Center">
        <Grid ColumnDefinitions="*,328" ColumnSpacing="28" MinHeight="380">
          <StackPanel Grid.Column="0" VerticalAlignment="Center" Spacing="16">
            <TextBlock Text="你的電影收藏" FontSize="12" FontWeight="SemiBold"
                       Foreground="#F3C688" LetterSpacing="2"/>
            <TextBlock Text="{Binding FeaturedCard.Title}" FontSize="36"
                       FontWeight="SemiBold" TextWrapping="Wrap"
                       MaxLines="3" Foreground="#F7FAFD"/>
            <Button x:Name="BigPictureDetailsRename" Classes="bp-secondary"
                    Content="✎  編輯片名" HorizontalAlignment="Left"
                    Click="DetailsRename_Click"
                    AutomationProperties.AutomationId="Lapis.Library.DetailRename"
                    AutomationProperties.Name="修改這部收藏電影的顯示名稱"/>
            <StackPanel x:Name="BigPictureRenameEditor" IsVisible="False" Spacing="7">
              <TextBlock Text="自訂顯示名稱（不會更名或搬動原始影片）"
                         Foreground="#B2C5D6" FontSize="12"/>
              <TextBox x:Name="BigPictureRenameInput"
                       AutomationProperties.AutomationId="Lapis.Library.RenameInput"
                       MaxLength="160" Width="440" HorizontalAlignment="Left"
                       Watermark="輸入電影片名" FontSize="17"
                       Background="#1D3044" Foreground="#FFF6E9"/>
              <TextBlock x:Name="BigPictureRenameError" IsVisible="False"
                         Foreground="#EAB4A3" TextWrapping="Wrap"
                         FontSize="12"/>
              <StackPanel Orientation="Horizontal" Spacing="9">
                <Button Classes="bp-primary" Content="儲存片名"
                        Click="DetailsRenameSave_Click"
                        AutomationProperties.AutomationId="Lapis.Library.RenameSave"/>
                <Button Classes="bp-secondary" Content="取消"
                        Click="DetailsRenameCancel_Click"
                        AutomationProperties.AutomationId="Lapis.Library.RenameCancel"/>
              </StackPanel>
            </StackPanel>
            <StackPanel Orientation="Horizontal" Spacing="15">
              <TextBlock Text="{Binding FeaturedCard.KindLabel}" FontSize="14"
                         Foreground="#C4EAF6"/>
              <TextBlock Text="{Binding FeaturedCard.AvailabilityLabel}"
                         Foreground="#AFC2D1" FontSize="14"/>
            </StackPanel>
            <TextBlock Text="收藏資訊" FontSize="15" FontWeight="Medium"
                       Margin="0,12,0,0" Foreground="#F6F2EC"/>
            <StackPanel Orientation="Horizontal" Spacing="12">
              <TextBlock Text="加入日期" FontSize="13" Foreground="#99AEC0"/>
              <TextBlock Text="{Binding FeaturedCard.ImportedAtText}"
                         FontSize="13" Foreground="#D9E8F3"/>
            </StackPanel>
            <TextBlock Text="{Binding FeaturedCard.LastWatchedLabel}"
                       IsVisible="{Binding FeaturedCard.HasWatchHistory}"
                       Foreground="#A8BDCE" FontSize="13"/>
            <TextBlock Text="本機海報支援：影片同名 .poster.jpg／.jpg／.png，或單片資料夾內的 folder.jpg"
                       TextWrapping="Wrap" FontSize="11" Foreground="#7393A9"
                       IsVisible="{Binding FeaturedCard.ShowPlaceholder}"/>
            <TextBlock Text="{Binding FeaturedCard.HistoryLabel}"
                       IsVisible="{Binding FeaturedCard.HasWatchHistory}"
                       Foreground="#F3C688" FontSize="14"/>
            <TextBlock Text="{Binding FeaturedCard.ProgressLabel}"
                       IsVisible="{Binding FeaturedCard.CanResume}"
                       Foreground="#F0C58C" FontSize="14"/>
            <TextBlock Text="來源移動或硬碟代號改變？選擇原本同一部影片或 Blu-ray 的新位置，保留觀看紀錄與最愛。"
                       IsVisible="{Binding FeaturedCard.NeedsSourceRepair}"
                       TextWrapping="Wrap" FontSize="13" Foreground="#E9C39D" MaxWidth="490"/>
            <TextBlock Text="來源路徑" FontSize="12" FontWeight="SemiBold"
                       Foreground="#D0B893" Margin="0,6,0,0"/>
            <TextBlock Text="{Binding FeaturedCard.SourcePath}"
                       TextWrapping="Wrap" FontSize="12" MaxWidth="510"
                       Foreground="#ADBFD0" MaxLines="3"
                       AutomationProperties.AutomationId="Lapis.Library.DetailSourcePath"/>
            <StackPanel Orientation="Horizontal" Spacing="10">
              <Button Classes="bp-secondary" Content="複製路徑"
                      Click="DetailsCopyPath_Click"
                      AutomationProperties.AutomationId="Lapis.Library.DetailCopyPath"
                      AutomationProperties.Name="複製目前電影的來源路徑"/>
              <Button Classes="bp-secondary" Content="在檔案總管中顯示"
                      Click="DetailsReveal_Click"
                      IsEnabled="{Binding FeaturedCard.IsAvailable}"
                      AutomationProperties.AutomationId="Lapis.Library.DetailReveal"
                      AutomationProperties.Name="在檔案總管中顯示目前電影"/>
            </StackPanel>
            <TextBlock Text="資訊來自本機電影庫，沒有擅自下載外部電影資料。"
                       TextWrapping="Wrap" FontSize="12"
                       Foreground="#8FA5B8" MaxWidth="490"/>
            <Button Classes="bp-secondary" Content="{Binding FeaturedCard.FavoriteActionLabel}"
                    HorizontalAlignment="Left"
                    Click="DetailsFavorite_Click"
                    AutomationProperties.AutomationId="Lapis.Library.DetailFavorite"
                    AutomationProperties.Name="{Binding FeaturedCard.FavoriteActionLabel}"/>
            <!-- Sidecar artwork refresh works without restarting Lapis or playback. -->
            <StackPanel Orientation="Horizontal" Spacing="12" Margin="0,5,0,0">
              <Button Classes="bp-secondary" Content="⟳  重新掃描封面"
                      Click="DetailsRefreshPoster_Click"
                      IsEnabled="{Binding FeaturedCard.CanRefreshPoster}"
                      AutomationProperties.AutomationId="Lapis.Library.DetailRefreshPoster"
                      AutomationProperties.Name="重新掃描此電影的本機封面"/>
              <TextBlock Text="{Binding FeaturedCard.PosterRefreshStatus}"
                         AutomationProperties.AutomationId="Lapis.Library.PosterRefreshStatus"
                         FontSize="12" Foreground="#A7D9E7"
                         VerticalAlignment="Center" TextWrapping="Wrap"/>
            </StackPanel>
            <WrapPanel Orientation="Horizontal" ItemSpacing="12" LineSpacing="10"
                       Margin="0,18,0,0">
              <Button x:Name="BigPictureDetailsResume" Classes="bp-primary"
                      Content="▶  繼續播放" Click="DetailsResume_Click"
                      IsVisible="{Binding FeaturedCard.CanResume}"
                      AutomationProperties.AutomationId="Lapis.Library.DetailResume"
                      AutomationProperties.Name="從上次觀影進度繼續播放"/>
              <Button x:Name="BigPictureDetailsRepair" Classes="bp-primary"
                      Content="修復來源位置…" Click="DetailsRepairSource_Click"
                      IsVisible="{Binding FeaturedCard.NeedsSourceRepair}"
                      AutomationProperties.AutomationId="Lapis.Library.DetailRepairSource"
                      AutomationProperties.Name="選擇相同影片或 Blu-ray 的新位置以修復失效來源"/>
              <Button x:Name="BigPictureDetailsPlay" Classes="bp-secondary"
                      Content="從頭播放" Click="DetailsPlay_Click"
                      IsEnabled="{Binding FeaturedCard.IsAvailable}"
                      AutomationProperties.AutomationId="Lapis.Library.DetailPlay"
                      AutomationProperties.Name="播放目前選取的電影"/>
              <Button Classes="bp-secondary" Content="移除觀看紀錄"
                      Click="DetailsForget_Click"
                      IsVisible="{Binding FeaturedCard.HasWatchHistory}"
                      AutomationProperties.AutomationId="Lapis.Library.DetailForget"
                      AutomationProperties.Name="移除此電影的觀看紀錄與續播位置"/>
              <Button x:Name="BigPictureDetailsRemove" Classes="bp-secondary"
                      Content="從收藏庫移除…" Click="DetailsRemove_Click"
                      AutomationProperties.AutomationId="Lapis.Library.DetailRemove"
                      AutomationProperties.Name="從收藏庫移除此電影但不刪除原始檔案"/>
              <Button Classes="bp-secondary" Content="返回收藏庫"
                      Click="DetailsClose_Click"
                      AutomationProperties.AutomationId="Lapis.Library.DetailClose"
                      AutomationProperties.Name="關閉電影詳細資訊"/>
            </WrapPanel>
            <StackPanel x:Name="BigPictureRemoveConfirmation" IsVisible="False"
                        Spacing="9" Margin="0,4,0,0">
              <TextBlock Text="確定從 Lapis 收藏庫移除這部電影？硬碟上的影片或 BDMV 資料夾不會刪除；最愛和觀看紀錄也會清理。"
                         FontSize="13" Foreground="#EFC5B2"
                         TextWrapping="Wrap" MaxWidth="495"/>
              <StackPanel Orientation="Horizontal" Spacing="12">
                <Button x:Name="BigPictureRemoveCancel" Classes="bp-secondary"
                        Content="取消移除" Click="DetailsRemoveCancel_Click"
                        AutomationProperties.AutomationId="Lapis.Library.RemoveCancel"/>
                <Button Classes="bp-secondary" Content="確認移出收藏庫"
                        Click="DetailsRemoveConfirm_Click"
                        AutomationProperties.AutomationId="Lapis.Library.RemoveConfirm"
                        AutomationProperties.Name="確認移除收藏項目，但保留硬碟上的媒體檔案"/>
              </StackPanel>
            </StackPanel>
          </StackPanel>
          <Border Grid.Column="1" Width="328" Height="328" CornerRadius="12"
                  Background="#243448" ClipToBounds="True"
                  VerticalAlignment="Center">
            <Grid>
              <Image Source="{Binding FeaturedCard.Poster}" Stretch="Uniform"/>
              <TextBlock Text="{Binding FeaturedCard.PlaceholderGlyph}" IsVisible="{Binding FeaturedCard.ShowPlaceholder}"
                         FontSize="85" Foreground="#637D96"
                         HorizontalAlignment="Center" VerticalAlignment="Center"/>
              <TextBlock Text="{Binding FeaturedCard.PlaceholderCaption}"
                         IsVisible="{Binding FeaturedCard.ShowPlaceholder}"
                         FontSize="12" LetterSpacing="2" Foreground="#9BB1C5"
                         HorizontalAlignment="Center" VerticalAlignment="Bottom"
                         Margin="0,0,0,35"/>
            </Grid>
          </Border>
        </Grid>
        </Border>
      </ScrollViewer>
    </Grid>
  </Grid>
</UserControl>
