<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:video="clr-namespace:Lapis.Desktop.Avalonia.Controls"
        xmlns:views="clr-namespace:Lapis.Desktop.Avalonia.Views"
        x:Class="Lapis.Desktop.Avalonia.Views.MainWindow"
        Title="Lapis · Your Cinema" Width="1320" Height="810"
        MinWidth="980" MinHeight="580"
        Background="#090D14" Foreground="#F6F2EC">
  <Window.Resources>
    <!-- Cinema dark palette. Single set of brush tokens shared across grid,
         list, context menus, navigation, and animated states. -->
    <SolidColorBrush x:Key="LibraryCanvas" Color="#090D14"/>
    <SolidColorBrush x:Key="LibrarySurface" Color="#141C29"/>
    <SolidColorBrush x:Key="LibrarySurfaceAlt" Color="#1B2C40"/>
    <SolidColorBrush x:Key="LibraryAccent" Color="#F0C58C"/>
    <SolidColorBrush x:Key="LibraryAccentHover" Color="#FFE0B3"/>
    <SolidColorBrush x:Key="LibraryAccentSoft" Color="#304E65"/>
    <SolidColorBrush x:Key="LibraryText" Color="#F0F5FA"/>
    <SolidColorBrush x:Key="LibrarySubtext" Color="#A6BACB"/>
    <SolidColorBrush x:Key="LibraryBorder" Color="#304154"/>
    <SolidColorBrush x:Key="LibraryHover" Color="#263D50"/>
  </Window.Resources>

  <Window.Styles>
    <Style Selector="Button.shell-brand">
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="Foreground" Value="#F6F2EC"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="CornerRadius" Value="12"/>
      <Setter Property="Padding" Value="6,9"/>
      <Setter Property="Cursor" Value="Hand"/>
    </Style>
    <Style Selector="Button.shell-tab">
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="Foreground" Value="#9EAABB"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="CornerRadius" Value="12"/>
      <Setter Property="Padding" Value="14,11"/>
      <Setter Property="FontSize" Value="13"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Transitions">
        <Transitions>
          <BrushTransition Property="Background" Duration="0:0:0.15"/>
          <BrushTransition Property="Foreground" Duration="0:0:0.15"/>
        </Transitions>
      </Setter>
    </Style>
    <Style Selector="Button.shell-tab:pointerover, Button.shell-tab:focus-visible">
      <Setter Property="Background" Value="#253345"/>
      <Setter Property="Foreground" Value="#FFFFFF"/>
    </Style>
    <Style Selector="Button.shell-tab.selected">
      <Setter Property="Background" Value="#334153"/>
      <Setter Property="Foreground" Value="#FFD99F"/>
    </Style>
    <Style Selector="Button.shell-import">
      <Setter Property="Background" Value="#F0C58C"/>
      <Setter Property="Foreground" Value="#261B12"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="CornerRadius" Value="12"/>
      <Setter Property="Padding" Value="18,12"/>
      <Setter Property="FontSize" Value="13"/>
      <Setter Property="FontWeight" Value="Bold"/>
      <Setter Property="Cursor" Value="Hand"/>
    </Style>
    <Style Selector="Button.shell-import:pointerover, Button.shell-import:focus-visible">
      <Setter Property="Background" Value="#FFE0B3"/>
    </Style>
  </Window.Styles>

  <Grid>
  <!-- Library and Watch are dark; Native video host remains isolated. -->
  <ThemeVariantScope RequestedThemeVariant="Dark">
    <Grid x:Name="LibraryPage" RowDefinitions="Auto,*"
          IsVisible="True" DragDrop.AllowDrop="True"
          Background="{StaticResource LibraryCanvas}">

      <!-- Single persistent library toolbar; BigPicture owns both presentation modes. -->
      <Border x:Name="CinemaLibraryHeader"
              AutomationProperties.AutomationId="Lapis.Library.Header"
              Grid.Row="0" IsVisible="True" Height="78" Padding="32,10"
              Background="#F00F1620" BorderBrush="#344053" BorderThickness="0,0,0,1">
        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="28">
          <Button Classes="shell-brand" Click="GoBigPicture_Click"
                  AutomationProperties.AutomationId="Lapis.Library.Home"
                  AutomationProperties.Name="LAPIS，返回電影庫首頁"
                  ToolTip.Tip="返回 Big Picture 電影庫">
            <StackPanel Orientation="Horizontal" Spacing="9" VerticalAlignment="Center">
              <TextBlock Text="LAPIS" FontSize="23" FontWeight="Bold"
                         LetterSpacing="3" VerticalAlignment="Center"/>
              <TextBlock Text="◆" FontSize="14" Foreground="#F0C58C"
                         VerticalAlignment="Center"/>
            </StackPanel>
          </Button>
          <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="5"
                      VerticalAlignment="Center">
            <Button Classes="shell-tab" Classes.selected="{Binding IsAllCategory}"
                    Content="首頁" Click="ShellAll_Click"/>
            <Button Classes="shell-tab" Classes.selected="{Binding IsRecentlyAddedCategory}"
                    Content="最近加入" Click="ShellRecent_Click"/>
            <Button Classes="shell-tab" Classes.selected="{Binding IsBluRayCategory}"
                    Content="Blu-ray" Click="ShellBluRay_Click"/>
            <Button Classes="shell-tab" Classes.selected="{Binding IsVideoCategory}"
                    Content="本機影片" Click="ShellVideos_Click"/>
            <Button Classes="shell-tab" Classes.selected="{Binding IsHistoryCategory}"
                    Content="觀看紀錄" Click="ShellHistory_Click"
                    AutomationProperties.AutomationId="Lapis.Library.HistoryTab"/>
            <Button Classes="shell-tab" Classes.selected="{Binding IsFavoritesCategory}"
                    Content="★ 我的最愛" Click="ShellFavorites_Click"
                    AutomationProperties.AutomationId="Lapis.Library.FavoritesTab"/>
          </StackPanel>
          <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8"
                      VerticalAlignment="Center">
            <Button Classes="shell-import" Content="＋ 新增媒體"
                    AutomationProperties.AutomationId="Lapis.Library.Add"
                    AutomationProperties.Name="新增影片或 Blu-ray"
                    ToolTip.Tip="新增收藏，不會立即播放">
              <Button.Flyout>
                <MenuFlyout Placement="Bottom">
                  <MenuItem Header="匯入影片檔案…" Click="ImportFiles_Click"/>
                  <MenuItem Header="匯入完整 Blu-ray 資料夾…" Click="ImportDisc_Click"/>
                </MenuFlyout>
              </Button.Flyout>
            </Button>
          </StackPanel>
        </Grid>
      </Border>

      <views:BigPictureLibraryView x:Name="BigPictureLibrary"
                                   Grid.Row="1" ZIndex="30"/>

      <!-- Non-interactive drag preview over the entire library surface.
           Do not overlay NativeControlHost; drop only indexes the catalog. -->
      <Grid x:Name="LibraryDropOverlay" Grid.RowSpan="2" ZIndex="100"
            Background="#E80A121B" IsVisible="False"
            IsHitTestVisible="False">
        <Border BorderBrush="{StaticResource LibraryAccent}"
                BorderThickness="2" CornerRadius="14" Margin="24"
                Background="#D7172836">
          <StackPanel VerticalAlignment="Center"
                      HorizontalAlignment="Center" Spacing="14">
            <TextBlock Text="＋" FontSize="50" Foreground="{StaticResource LibraryAccent}"
                       HorizontalAlignment="Center"/>
            <TextBlock Text="拖曳到這裡，加入收藏庫" FontSize="25"
                       FontWeight="SemiBold" Foreground="{StaticResource LibraryText}"
                       HorizontalAlignment="Center"/>
            <TextBlock Text="影片檔案 · 完整 Blu-ray 光碟根目錄 · BDMV 資料夾"
                       FontSize="13" Foreground="{StaticResource LibrarySubtext}"
                       HorizontalAlignment="Center"/>
            <TextBlock Text="只建立索引，不複製檔案、不會立即播放"
                       FontSize="12" Foreground="{StaticResource LibraryAccent}"
                       HorizontalAlignment="Center"/>
          </StackPanel>
        </Border>
      </Grid>
    </Grid>
  </ThemeVariantScope>

  <!-- D3D11 has its own Win32 HWND. Video occupies the WHOLE Watch page.
       The owned transparent WatchChromeWindow lives ABOVE that HWND. -->
  <Grid x:Name="PlayerPage" IsVisible="False" Background="#000000">
    <video:WindowsVideoSurface x:Name="VideoSurface"/>
  </Grid>
  </Grid>
</Window>
